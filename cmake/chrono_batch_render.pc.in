prefix=${pcfiledir}/@chrono_batch_render_pc_to_prefix@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@

Name: @chrono_batch_render_pc_name@
Description: @chrono_batch_render_pc_description@
Version: @PROJECT_VERSION@
URL: @PROJECT_HOMEPAGE_URL@
Requires: @chrono_batch_render_pc_requires@
Cflags: -I${includedir} @chrono_batch_render_pc_dlpack@ @chrono_batch_render_pc_cflags@
Libs: -L${libdir} -l@chrono_batch_render_pc_library@
