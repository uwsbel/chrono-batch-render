file(READ "${PRELUDE}" text)
file(READ "${COMPUTE_OVERLAY}" overlay)

function(chrono_batch_render_missing what)
    message(
        FATAL_ERROR
        "The HIP prelude no longer finds ${what} in ${PRELUDE}; update "
        "cmake/ChronoBatchRenderPrelude.cmake and chrono_batch_render/device/hip/prelude.hip for this Slang version"
    )
endfunction()

function(chrono_batch_render_replace what old new)
    string(
        FIND "${text}"
        "${old}"
        at
    )
    if(at EQUAL -1)
        chrono_batch_render_missing("${what}")
    endif()
    string(
        REPLACE "${old}"
        "${new}"
        text
        "${text}"
    )
    set(text "${text}" PARENT_SCOPE)
endfunction()

function(chrono_batch_render_cut what start finish)
    string(
        FIND "${text}"
        "${start}"
        begin
    )
    if(begin EQUAL -1)
        chrono_batch_render_missing("${what}")
    endif()
    string(SUBSTRING "${text}" ${begin} -1 rest)
    string(
        FIND "${rest}"
        "${finish}"
        length
    )
    if(length EQUAL -1)
        chrono_batch_render_missing("${what}")
    endif()
    string(SUBSTRING "${text}" 0 ${begin} before)
    string(SUBSTRING "${rest}" ${length} -1 after)
    set(text "${before}${after}" PARENT_SCOPE)
endfunction()

if(DEFINED HIP_OVERLAY)
    file(READ "${HIP_OVERLAY}" hipOverlay)
    string(APPEND overlay "\n${hipOverlay}")
    chrono_batch_render_replace(
        "the runtime compiler's guard"
        "#ifdef __CUDACC_RTC__"
        "#if defined(__CUDACC_RTC__) || defined(__HIPCC_RTC__)"
    )
    chrono_batch_render_replace(
        "the vector constructors"
        "#if SLANG_CUDA_RTC\nSLANG_MAKE_VECTOR(int)"
        "#if SLANG_CUDA_RTC && !defined(__HIPCC_RTC__)\nSLANG_MAKE_VECTOR(int)"
    )
    chrono_batch_render_replace(
        "the vector constructors from scalars"
        "#if SLANG_CUDA_RTC\n#define SLANG_MAKE_VECTOR_FROM_SCALAR(T)"
        "#if SLANG_CUDA_RTC && !defined(__HIPCC_RTC__)\n#define SLANG_MAKE_VECTOR_FROM_SCALAR(T)"
    )
    chrono_batch_render_replace(
        "the lane mask type"
        "typedef int WarpMask;"
        "typedef unsigned long long WarpMask;"
    )
    chrono_batch_render_replace("the first lane of a mask" "__ffs(mask)" "__ffsll(mask)")
    chrono_batch_render_replace(
        "the lane index"
        "return ((threadIdx.z * blockDim.y + threadIdx.y) * blockDim.x + threadIdx.x) &\n           SLANG_CUDA_WARP_MASK;"
        "return __lane_id();"
    )
    chrono_batch_render_cut(
        "the float compare-and-swap"
        "// Float bitwise atomic compare-and-swap"
        "// =====================================================================\n// Atomic Reduction"
    )
    chrono_batch_render_cut(
        "the atomic reductions"
        "// Atomic reduction ADD operations"
        "// =====================================================================\n// End of Atomic Reduction"
    )
    chrono_batch_render_cut(
        "the surface writes"
        "// Support for doing format conversion when writing to a surface/RWTexture"
        "// ----------------------------- F16 ---"
    )
    chrono_batch_render_cut(
        "the PTX texture fetches"
        "// Implementations for texture fetch/load functions using tex PTX intrinsics"
        "// Wave rotate helper functions"
    )
endif()

file(
    WRITE "${OUTPUT}.tmp"
    "// Generated by cmake/ChronoBatchRenderPrelude.cmake from Chrono Batch Render's overlays and ${PRELUDE}; do not edit.\n${overlay}\n${text}"
)
execute_process(
    COMMAND
        "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}"
)
file(REMOVE "${OUTPUT}.tmp")
